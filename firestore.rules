rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email.lower() == 'vkatakam@gitam.edu') ||
        (request.auth.uid == '2bEghd98c7R9gl6pYm6HErrjW7w2') ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidCheckInRecord(data) {
      return data.keys().hasAll(['updatedAt']) &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 100 &&
             (data.remarks == null || data.remarks is string) &&
             data.students is list &&
             data.studentIds is list &&
             data.courses is list &&
             data.years is list &&
             data.contacts is list &&
             data.parentCtcs is list &&
             data.signatures is list &&
             (data.designations == null || data.designations is list) &&
             data.amenities is map &&
             data.checkinDates is list &&
             data.checkoutDates is list &&
             data.isReservedList is list &&
             (data.laundryEligibleList == null || data.laundryEligibleList is list);
    }

    function isValidHistoricalRecord(data) {
      return data.id is string &&
             data.buildingId is string &&
             data.buildingName is string &&
             data.roomNumber is string &&
             data.studentName is string &&
             data.studentId is string &&
             data.checkinDate is string &&
             data.checkoutDate is string &&
             data.course is string &&
             data.year is string &&
             (data.designation == null || data.designation is string) &&
             data.contact is string &&
             data.parentContact is string &&
             data.roomType is string &&
             (data.remarks == null || data.remarks is string) &&
             (data.signature == null || data.signature is string) &&
             (data.laundryEligible == null || data.laundryEligible is bool);
    }

    function isValidBuilding(data) {
      return data.id is string &&
             data.name is string;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'isAdmin']) && 
             data.uid is string &&
             data.email is string &&
             data.isAdmin is bool;
    }

    // Resource Logic
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isSignedIn() && 
                   (
                     (request.auth.uid == userId && isValidUserProfile(incoming()) && (incoming().isAdmin == false || isAdmin())) ||
                     (isAdmin() && isValidUserProfile(incoming()))
                   );
    }

    match /config/buildings {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /buildings/{buildingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidBuilding(incoming());
    }

    match /checkins/{checkInId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(checkInId) && isValidCheckInRecord(incoming());
    }

    match /history/{historyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(historyId) && isValidHistoricalRecord(incoming());
      allow update, delete: if isAdmin() && isValidId(historyId);
    }
  }
}
