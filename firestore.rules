rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vkatakam@gitam.edu'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidCheckInRecord(data) {
      return data.keys().hasAll(['updatedAt']) &&
             data.updatedAt is string;
    }

    function isValidHistoricalRecord(data) {
      return data.id is string &&
             data.buildingId is string &&
             data.studentName is string &&
             data.studentId is string &&
             data.checkinDate is string;
    }

    function isValidBuilding(data) {
      return data.id is string &&
             data.name is string;
    }

    // Resource Logic
    match /buildings/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'vkatakam@gitam.edu';
    }

    match /checkins/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /history/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.email == 'vkatakam@gitam.edu';
    }
  }
}
